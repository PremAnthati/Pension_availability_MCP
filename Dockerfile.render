FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# Install system dependencies: Nginx, Supervisor, PostgreSQL (client + server), gettext-base (envsubst), cron, curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    supervisor \
    gettext-base \
    postgresql \
    postgresql-client \
    cron \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

# Set up required system directories
RUN mkdir -p /var/sewasetu/uploads /var/log/sewasetu /var/log/supervisor /etc/supervisor/conf.d

WORKDIR /app

# Install Python dependencies across all services with pinned stable versions
RUN pip install --no-cache-dir \
    setuptools \
    "gunicorn>=22.0.0" \
    Flask==2.2.5 \
    psycopg2-binary==2.9.9 \
    requests==2.28.2 \
    fpdf2==2.7.4 \
    "PyJWT[crypto]>=2.9.0" \
    fastapi>=0.100.0 \
    "mcp==1.30.0" \
    "fastmcp==2.14.7" \
    "pydantic==2.14.1" \
    "uvicorn[standard]>=0.29.0" \
    "httpx>=0.27.0" \
    "starlette>=0.37.0"

# Copy application components
COPY app/ /app/app/
COPY mcp/ /app/mcp/
COPY personas/ /app/personas/
COPY evals/ /app/evals/
COPY smsgw/ /app/smsgw/
COPY seed/ /app/seed/
COPY init_db.py /app/init_db.py
COPY render-entrypoint.sh /app/render-entrypoint.sh
COPY nginx.render.conf.template /etc/nginx/nginx.render.conf.template
COPY supervisord.render.conf /etc/supervisor/conf.d/supervisord.conf

RUN chmod +x /app/render-entrypoint.sh

# Default port for Render
EXPOSE 10000

CMD ["/app/render-entrypoint.sh"]
